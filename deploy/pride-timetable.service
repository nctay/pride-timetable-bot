[Unit]
Description=Pride Fitness Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/pride-timetable
ExecStart=/usr/bin/python3 /opt/pride-timetable/pride_bot.py bot
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pride-timetable

[Install]
WantedBy=multi-user.target
